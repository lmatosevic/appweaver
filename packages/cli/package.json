    "scaffoldDependencies"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lmatosevic/appweaver.git",
    "directory": "packages/cli"
  },
  "maintainers": [
    {
      "name": "Luka Matosevic",
      "email": "lukamatosevic5@gmail.com",
      "web": "https://lukamatosevic.com"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 24.7"
  },
  "scripts": {
    "weaver": "node ./dist/weaver.js"
  },
  "dependencies": {
    "@appweaver/create": "^2.8.0",
    "@sinclair/typebox": "0.34.49",
    "@sinclair/typebox-codegen": "0.11.1",
    "commander": "15.0.0",
    "fkill": "10.0.3",
    "glob": "14.0.4",
    "prettier": "3.8.4",
    "rimraf": "6.1.4",
    "ts-node": "10.9.2",
    "tsc-alias": "1.8.17",
    "tsc-watch": "7.2.0"
  },
  "devDependencies": {
    "@appweaver/core": "^2.8.0",
    "@appweaver/common": "^2.8.0",
    "@types/bun": "1.4.2"
