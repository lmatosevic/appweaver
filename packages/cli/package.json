  "peerDependencies": {
    "@appweaver/core": "^2.8.0",
    "@appweaver/common": "^2.8.0",
    "prisma": "^7.9.0",
    "typescript": "^5.9.0",
    "@appweaver/data": "^2.8.0",
    "@appweaver/web": "^2.8.0"
  },
  "peerDependenciesMeta": {
    "@appweaver/data": {
      "optional": true
    },
    "@appweaver/web": {
      "optional": true
    },
    "prisma": {
      "optional": true
    }
