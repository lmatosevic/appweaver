{
  "extends": "../tsconfig.build.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "types": ["node", "bun"],
    "paths": {
      "@appweaver/core": ["../core"],
      "@appweaver/core/*": ["../core/*"],
      "@appweaver/common": ["../common"],
      "@appweaver/common/*": ["../common/*"],
      "@appweaver/create-weaver-app/*": ["../create-weaver-app/*"],
      "@appweaver/data": ["../data"],
      "@appweaver/data/*": ["../data/*"],
      "@appweaver/web": ["../web"],
      "@appweaver/web/*": ["../web/*"]
    }
  },
  "exclude": ["node_modules", "dist", "test/**/*", "**/*.test.ts"],
  "references": [
    {
      "path": "../common/tsconfig.build.json"
    },
    {
      "path": "../core/tsconfig.build.json"
    },
    {
      "path": "../create-weaver-app/tsconfig.build.json"
    },
    {
      "path": "../data/tsconfig.build.json"
    },
    {
      "path": "../web/tsconfig.build.json"
    }
  ]
}
