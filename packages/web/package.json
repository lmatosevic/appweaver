{
  "name": "@appweaver/web",
  "version": "2.0.1",
  "description": "Appweaver - the backend framework for AI-first development (@web)",
  "author": "Luka Matosevic",
  "license": "MIT",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./config": {
      "types": "./config.d.ts",
      "default": "./config.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "appweaver",
    "appweaver-module"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lmatosevic/appweaver.git",
    "directory": "packages/web"
  },
  "maintainers": [
    {
      "name": "Luka Matosevic",
      "email": "lukamatosevic5@gmail.com",
      "web": "https://lukamatosevic.com"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 24.7"
  },
  "appweaver": {
    "module": "./module.js"
  },
  "dependencies": {
    "@fastify/ajv-compiler": "4.0.5",
    "@fastify/auth": "5.1.1",
    "@fastify/basic-auth": "6.3.0",
    "@fastify/cors": "11.3.0",
    "@fastify/fast-json-stringify-compiler": "5.0.3",
    "@fastify/helmet": "13.1.1",
    "@fastify/jwt": "10.2.5",
    "@fastify/multipart": "10.1.2",
    "@fastify/oauth2": "8.3.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/request-context": "7.0.0",
    "@fastify/static": "10.1.5",
    "@fastify/swagger": "9.9.1",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "@sinclair/typebox": "0.34.49",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.0"
  },
  "peerDependencies": {
    "@appweaver/common": "^1.12.2",
    "@appweaver/core": "^1.12.2",
    "@appweaver/data": "^1.12.2"
  },
  "devDependencies": {
    "@appweaver/common": "^1.12.2",
    "@appweaver/core": "^1.12.2",
    "@appweaver/data": "^1.12.2"
  }
}
