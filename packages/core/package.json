{
  "name": "@appweaver/core",
  "version": "2.0.0",
  "description": "Appweaver - the backend framework for AI-first development (@core)",
  "author": "Luka Matosevic",
  "license": "MIT",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./config": {
      "types": "./config.d.ts",
      "default": "./config.js"
    },
    "./drivers": {
      "types": "./drivers.d.ts",
      "default": "./drivers.js"
    },
    "./internal": {
      "types": "./internal.d.ts",
      "default": "./internal.js"
    },
    "./app/application": {
      "types": "./app/application.d.ts",
      "default": "./app/application.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lmatosevic/appweaver.git",
    "directory": "packages/core"
  },
  "maintainers": [
    {
      "name": "Luka Matosevic",
      "email": "lukamatosevic5@gmail.com",
      "web": "https://lukamatosevic.com"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 24.7"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.49",
    "flatted": "3.4.2"
  },
  "devDependencies": {
    "@appweaver/common": "^1.6.0"
  },
  "peerDependencies": {
    "@appweaver/common": "^1.6.0"
  }
}
