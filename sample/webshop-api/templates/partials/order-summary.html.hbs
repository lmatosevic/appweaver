<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin: 16px 0; border-collapse: collapse">
  <tr>
    <th align="left" style="padding: 8px 0; border-bottom: 1px solid #e4e7eb">{{t "orders.summary.product"}}</th>
    <th align="right" style="padding: 8px 0; border-bottom: 1px solid #e4e7eb">{{t "orders.summary.quantity"}}</th>
    <th align="right" style="padding: 8px 0; border-bottom: 1px solid #e4e7eb">{{t "orders.summary.price"}}</th>
  </tr>
  {{#each order.items}}
    <tr>
      <td style="padding: 8px 0">
        {{productName}}<br />
        <span style="font-size: 12px; color: #7b8794">{{sku}}</span>
      </td>
      <td align="right" style="padding: 8px 0">{{quantity}}</td>
      <td align="right" style="padding: 8px 0">{{money lineTotal}}</td>
    </tr>
  {{/each}}
  <tr>
    <td colspan="2" style="padding: 8px 0 0; border-top: 1px solid #e4e7eb">{{t "orders.summary.subtotal"}}</td>
    <td align="right" style="padding: 8px 0 0; border-top: 1px solid #e4e7eb">{{money order.subtotal}}</td>
  </tr>
  {{#if order.discount}}
    <tr>
      <td colspan="2">{{t "orders.summary.discount"}}{{#if order.coupon}} ({{order.coupon.code}}){{/if}}</td>
      <td align="right">-{{money order.discount}}</td>
    </tr>
  {{/if}}
  <tr>
    <td colspan="2">{{t "orders.summary.shipping"}}</td>
    <td align="right">
      {{#if order.shippingCost}}{{money order.shippingCost}}{{else}}{{t "orders.summary.freeShipping"}}{{/if}}
    </td>
  </tr>
  <tr>
    <td colspan="2"><strong>{{t "orders.summary.total"}}</strong></td>
    <td align="right"><strong>{{money order.total}}</strong></td>
  </tr>
</table>
<p style="font-size: 14px; line-height: 20px; color: #52606d">
  {{t "orders.summary.shipTo"}}<br />
  {{order.shippingAddress.recipient}}<br />
  {{order.shippingAddress.street}}<br />
  {{order.shippingAddress.postalCode}} {{order.shippingAddress.city}}<br />
  {{countryName order.shippingAddress.country}}
</p>
