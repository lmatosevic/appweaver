{
  "$schema": "./appweaver.schema.json",
  "config": {
    "app": {
      "name": "Webshop API",
      "description": "Appweaver sample - Webshop API with catalog, cart checkout and order fulfillment"
    },
    "server": {
      "host": "0.0.0.0",
      "port": 5002
    },
    "database": {
      "url": "postgresql://${DB_USER:-webshop-api}:${DB_PASSWORD}@${DB_HOST:-localhost}:5432/${DB_NAME:-webshop-api}"
    },
    "memory": {
      "redis": {
        "url": "redis://${REDIS_HOST:-localhost}:6379/0"
      }
    },
    "mailer": {
      "provider": "json",
      "senderName": "Webshop",
      "senderAddress": "orders@webshop.example.com"
    },
    "security": {
      "apiKey": {
        "enabled": true
      }
    },
    "system": {
      "adminInitialEmail": "admin@webshop.example.com"
    },
    "timeseries": {
      "provider": "timescale"
    },
    "ai": {
      "endpoints": {
        "openai": {
          "preset": "openai"
        },
        "local": {
          "preset": "ollama",
          "baseUrl": "http://${OLLAMA_HOST:-localhost}:11434/v1"
        }
      },
      "aliases": {
        "support": "openai:gpt-4.1-mini"
      }
    },
    "telemetry": {
      "endpoint": "http://${OTEL_HOST:-localhost}:4318",
      "logs": {
        "enabled": true
      },
      "http": {
        "ignorePaths": ["/public/*"]
      }
    }
  },
  "environments": {
    "dev": {
      "log": {
        "level": "debug",
        "pretty": true
      },
      "ai": {
        "aliases": {
          "support": "local:qwen3.5:9b"
        }
      },
      "template": {
        "cache": false,
        "preview": {
          "enabled": true
        }
      }
    },
    "test": {
      "log": {
        "level": "silent",
        "sync": true
      },
      "server": {
        "listen": false
      },
      "database": {
        "url": "postgresql://${DB_USER:-webshop-api}:${DB_PASSWORD}@${DB_HOST:-localhost}:5432/${DB_NAME:-webshop-api}-test",
        "schemaPath": "./temp/database/schema.prisma",
        "migrationsDirPath": "./temp/database/migrations",
        "clientOutputDirPath": "./temp/database/client"
      },
      "storage": {
        "path": "./temp/storage"
      },
      "memory": {
        "provider": "memory"
      },
      "pubsub": {
        "provider": "memory"
      },
      "queue": {
        "provider": "memory"
      },
      "scheduler": {
        "autoStartJob": false
      },
      "telemetry": {
        "enabled": false
      },
      "ai": {
        "aliases": {
          "support": "mock:echo"
        }
      }
    }
  }
}
