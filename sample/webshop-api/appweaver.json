{
  "$schema": "../../node_modules/@appweaver/common/config/schema.json",
  "config": {
    "app": {
      "name": "Webshop API",
      "description": "Appweaver sample - Webshop API with catalog, cart checkout and order fulfillment"
    },
    "server": {
      "host": "0.0.0.0",
      "port": 5002
    },
    "database": {
      "url": "postgresql://${DB_USER:-webshop-api}:${DB_PASSWORD}@${DB_HOST:-localhost}:5432/${DB_NAME:-webshop-api}"
    },
    "memory": {
      "redis": {
        "url": "redis://${REDIS_HOST:-localhost}:6379/0"
      }
    },
    "mailer": {
      "provider": "json",
      "senderName": "Webshop",
      "senderAddress": "orders@webshop.example.com"
    },
    "security": {
      "apiKey": {
        "enabled": true
      }
    },
    "system": {
      "adminInitialEmail": "admin@webshop.example.com"
    }
  },
  "environments": {
    "dev": {
      "log": {
        "level": "debug",
        "pretty": true
      },
      "template": {
        "cache": false,
        "preview": {
          "enabled": true
        }
      }
    },
    "test": {
      "log": {
        "level": "silent",
        "sync": true
      },
      "database": {
        "url": "postgresql://${DB_USER:-webshop-api}:${DB_PASSWORD}@${DB_HOST:-localhost}:5432/${DB_NAME:-webshop-api}-test",
        "schemaPath": "./temp/database/schema.prisma",
        "migrationsDirPath": "./temp/database/migrations",
        "clientOutputDirPath": "./temp/database/client"
      },
      "storage": {
        "path": "./temp/storage"
      },
      "memory": {
        "provider": "memory"
      },
      "queue": {
        "provider": "memory"
      },
      "scheduler": {
        "autoStartJob": false
      }
    }
  }
}
