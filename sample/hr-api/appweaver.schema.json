                    {
                      "const": "local",
                      "type": "string"
                    },
                    {
                      "const": "dev",
                      "type": "string"
                    },
                    {
                      "const": "staging",
                      "type": "string"
                    },
                    {
                      "const": "qa",
                      "type": "string"
                    },
                    {
                      "const": "prod",
