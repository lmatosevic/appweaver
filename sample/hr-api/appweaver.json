{
  "$schema": "./appweaver.schema.json",
  "config": {
    "app": {
      "name": "HR API",
      "description": "Appweaver sample - Human Resources API with employees, leave requests and documents"
    },
    "server": {
      "host": "0.0.0.0",
      "port": 5003
    },
    "database": {
      "url": "sqlserver://${DB_HOST:-localhost}:1433;database=${DB_NAME:-hr-api};user=${DB_USER:-sa};password=${DB_PASSWORD};trustServerCertificate=true"
    },
    "memory": {
      "provider": "memory"
    },
    "rateLimit": {
      "store": "local"
    },
    "queue": {
      "provider": "memory"
    },
    "mailer": {
      "provider": "json",
      "senderName": "HR Team",
      "senderAddress": "hr@example.com"
    },
    "system": {
      "adminInitialEmail": "admin@hr.example.com"
    }
  },
  "environments": {
    "dev": {
      "log": {
        "level": "debug",
        "pretty": true
      }
    },
    "test": {
      "log": {
        "level": "silent",
        "sync": true
      },
      "server": {
        "listen": false
      },
      "database": {
        "url": "sqlserver://${DB_HOST:-localhost}:1433;database=${DB_NAME:-hr-api}-test;user=${DB_USER:-sa};password=${DB_PASSWORD};trustServerCertificate=true",
        "schemaPath": "./temp/database/schema.prisma",
        "migrationsDirPath": "./temp/database/migrations",
        "clientOutputDirPath": "./temp/database/client"
      },
      "storage": {
        "path": "./temp/storage"
      },
      "memory": {
        "provider": "memory"
      },
      "queue": {
        "provider": "memory"
      },
      "scheduler": {
        "autoStartJob": false
      }
    }
  }
}
