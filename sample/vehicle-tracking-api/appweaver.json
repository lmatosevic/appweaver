{
  "$schema": "./appweaver.schema.json",
  "config": {
    "app": {
      "name": "Vehicle Tracking API",
      "description": "Appweaver sample - Vehicle tracking API with live positions, trips, routes, geofences and telemetry"
    },
    "server": {
      "host": "0.0.0.0",
      "port": 5008
    },
    "database": {
      "url": "postgresql://${DB_USER:-vehicle-tracking-api}:${DB_PASSWORD}@${DB_HOST:-localhost}:${DB_PORT:-5433}/${DB_NAME:-vehicle-tracking-api}"
    },
    "security": {
      "apiKey": {
        "enabled": true
      }
    },
    "spatial": {
      "provider": "postgis"
    },
    "system": {
      "adminInitialEmail": "admin@fleet.example.com"
    },
    "timeseries": {
      "provider": "timescale"
    }
  },
  "environments": {
    "dev": {
      "log": {
        "level": "debug",
        "pretty": true
      }
    },
    "test": {
      "log": {
        "level": "silent",
        "sync": true
      },
      "database": {
        "url": "postgresql://${DB_USER:-vehicle-tracking-api}:${DB_PASSWORD}@${DB_HOST:-localhost}:${DB_PORT:-5433}/${DB_NAME:-vehicle-tracking-api}-test",
        "schemaPath": "./temp/database/schema.prisma",
        "migrationsDirPath": "./temp/database/migrations",
        "clientOutputDirPath": "./temp/database/client"
      },
      "storage": {
        "path": "./temp/storage"
      },
      "server": {
        "listen": false
      },
      "scheduler": {
        "autoStartJob": false
      }
    }
  }
}
