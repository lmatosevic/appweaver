  trip             Trip?     @relation("AlertTripTrip", fields: [tripId], references: [id], onDelete: SetNull)
  tripId           Int?
  geofence         Geofence? @relation("AlertGeofenceGeofence", fields: [geofenceId], references: [id], onDelete: SetNull)
  geofenceId       Int?
  acknowledgedBy   User?     @relation("AlertAcknowledgedByUser", fields: [acknowledgedById], references: [id], onDelete: SetNull)
