  createdAt   DateTime @default(now())
  createdBy   User?    @relation("AlertCreatedByUser", fields: [createdById], references: [id])
  createdById Int?

  @@index([vehicleId, occurredAt(sort: Desc)])
  @@index([severity, acknowledgedAt, occurredAt(sort: Desc)])
  @@index([tripId])
  @@index([geofenceId])
  @@index([acknowledgedById])
  @@index([createdById])
  @@index([positionMinLng, positionMinLat])
  @@index([positionGeom], type: Gist)
}

