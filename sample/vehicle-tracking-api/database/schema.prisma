  /// Related columns
  driver          User?   @relation("UserVehiclesVehicle", fields: [driverId], references: [id])
  driverId        Int?
  assignedRoute   Route?  @relation("RouteVehiclesVehicle", fields: [assignedRouteId], references: [id])
  assignedRouteId Int?
  trips           Trip[]  @relation("TripVehicleVehicle")
