{
  "$schema": "./appweaver.schema.json",
  "config": {
    "app": {
      "name": "Loan Calculator",
      "description": "Appweaver sample - Loan calculator, a minimal application of the core module"
    },
    "loan": {
      "currency": "EUR"
    }
  },
  "environments": {
    "dev": {
      "log": {
        "level": "debug",
        "pretty": true
      }
    },
    "test": {
      "log": {
        "level": "silent",
        "sync": true
      }
    }
  }
}
