{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2024",
    "rootDir": "./",
    "outDir": "./dist",
    "strict": true,
    "sourceMap": true,
    "declaration": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "incremental": true,
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "types": ["node", "jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@db/*": ["./database/*"]
    }
  },
  "exclude": ["node_modules", "dist", "temp"]
}
