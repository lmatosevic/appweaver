{
  "$schema": "../../node_modules/@appweaver/common/config/schema.json",
  "config": {
    "app": {
      "name": "Movies DB Bun",
      "description": "Appweaver sample - Movies database API running on Bun",
      "runtime": "bun"
    },
    "server": {
      "host": "0.0.0.0",
      "port": 5005
    },
    "database": {
      "url": "file:./movies-db-bun.db"
    },
    "redis": {
      "provider": "@appweaver/core/memory/in-memory"
    },
    "cache": {
      "provider": "@appweaver/core/cache/memory-cache"
    },
    "rateLimit": {
      "store": "in-memory"
    },
    "queue": {
      "provider": "@appweaver/core/queue/memory-queue"
    },
    "mailer": {
      "enabled": false
    }
  }
}
