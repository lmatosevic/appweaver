{
  "$schema": "../../node_modules/@appweaver/common/config/schema.json",
  "config": {
    "app": {
      "name": "CMS API",
      "description": "Sample Appweaver application for CMS API",
      "hostname": "http://localhost:5001"
    },
    "server": {
      "port": 5001,
      "host": "localhost"
    },
    "database": {
      "url": "file:./data/cms-api.db"
    },
    "redis": {
      "url": "redis://${REDIS_HOST:-localhost}:6379/0"
    },
    "log": {
      "pretty": false
    }
  }
}
