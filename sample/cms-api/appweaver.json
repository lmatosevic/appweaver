{
  "$schema": "./appweaver.schema.json",
  "config": {
    "app": {
      "name": "CMS API",
      "description": "Sample Appweaver application for CMS API",
      "hostname": "http://localhost:5001"
    },
    "server": {
      "port": 5001,
      "host": "localhost"
    },
    "database": {
      "url": "file:./data/cms-api.db"
    },
    "storage": {
      "versions": {
        "enabled": true
      }
    },
    "audit": {
      "enabled": true,
      "retention": "30d",
      "auth": {
        "retention": "365d"
      },
      "read": {
        "enabled": true,
        "retention": "7d"
      }
    },
    "memory": {
      "redis": {
        "url": "redis://${REDIS_HOST:-localhost}:6379/0"
      }
    },
    "healthCheck": {
      "omitInstances": ["mailer"]
    },
    "mailer": {
      "senderName": "CMS",
      "senderAddress": "no-reply@cms.example.com"
    },
    "security": {
      "basic": {
        "enabled": true
      },
      "apiKey": {
        "enabled": true
      },
      "oauth2": {
        "google": {
          "enabled": true,
          "authorizationParams": {
            "prompt": "select_account"
          }
        },
        "facebook": {
          "enabled": true
        }
      },
      "recaptcha": {
        "enabled": true
      },
      "account": {
        "2fa": {
          "enabled": true,
          "totp": {
            "issuer": "CMS"
          }
        }
      }
    },
    "mcp": {
      "instructions": "The CMS of a blog. Posts are written as a Draft, then Published (or scheduled with a future publishedAt) and Archived. Look up the category and the tags of a post before creating it, and reuse an existing tag by its slug.",
      "destructiveEnabled": true,
      "oauth2": {
        "enabled": true,
        "passwordEnabled": true
      }
    },
    "resource": {
      "bulkCreateEnabled": true,
      "bulkUpdateEnabled": true,
      "bulkDeleteEnabled": true
    }
  },
  "environments": {
    "dev": {
      "log": {
        "level": "debug",
        "pretty": true,
        "levels": {
          "cache": "trace"
        }
      },
      "database": {
        "logEvents": ["query", "warn"]
      },
      "cache": {
        "cleanStart": true
      },
      "template": {
        "cache": false,
        "preview": {
          "enabled": true
        }
      }
    },
    "test": {
      "log": {
        "level": "silent",
        "sync": true
      },
      "server": {
        "listen": false
      },
      "database": {
        "url": "file:./temp/test.db",
        "schemaPath": "./temp/database/schema.prisma",
        "migrationsDirPath": "./temp/database/migrations",
        "clientOutputDirPath": "./temp/database/client"
      },
      "storage": {
        "path": "./temp/storage"
      },
      "memory": {
        "provider": "memory"
      },
      "queue": {
        "provider": "memory"
      },
      "mailer": {
        "provider": "json"
      },
      "scheduler": {
        "autoStartJob": false
      },
      "export": {
        "batchSize": 2
      },
      "sms": {
        "provider": "json"
      }
    }
  }
}
