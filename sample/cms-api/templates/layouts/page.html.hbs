<!DOCTYPE html>
<html lang="{{@locale}}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}} · {{@app.name}}</title>
    <style>
      body { margin: 0 auto; max-width: 720px; padding: 32px 16px; font-family: Georgia, serif; line-height: 1.6; color: #1f2933; }
      .meta, footer { color: #616e7c; font-size: 14px; }
      .tags { display: flex; gap: 8px; padding: 0; list-style: none; }
      .tags li { padding: 2px 8px; border-radius: 4px; background: #e4e7eb; }
    </style>
  </head>
  <body>
    {{> @partial-block}}
  </body>
</html>
