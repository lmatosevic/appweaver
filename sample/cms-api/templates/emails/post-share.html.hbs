{{#> layouts/email.html title=post.title}}
  <p>{{t "emails.greeting"}}</p>
  <p>{{t "emails.postShare.message" sender=sender}}</p>
  <h2 style="margin: 16px 0 8px; font-size: 20px">{{post.title}}</h2>
  {{#if post.excerpt}}
    <p>{{post.excerpt}}</p>
  {{/if}}
  {{> partials/email-button.html href=link label=(t "emails.postShare.action")}}
{{/layouts/email.html}}
