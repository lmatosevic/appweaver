NODE_ENV=dev

# The API key and the OAuth2 sign-in add the ApiKey and ConnectedAccount models,
# which the generated types and the end-to-end tests (user-cascade-delete) expect.
# Replace the Google credentials with real ones to sign in through Google.
SECURITY_API_KEY_ENABLED=true
SECURITY_OAUTH2_GOOGLE_ENABLED=true
SECURITY_OAUTH2_GOOGLE_CLIENT_ID=your-google-client-id
SECURITY_OAUTH2_GOOGLE_CLIENT_SECRET=your-google-client-secret
