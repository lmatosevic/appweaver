{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2024",
    "baseUrl": "./",
    "outDir": "./dist",
    "strict": true,
    "sourceMap": true,
    "declaration": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "incremental": true,
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "types": [
      "bun"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@db/*": [
        "./database/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "temp"
  ]
}
