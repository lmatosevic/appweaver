{
  "$schema": "../../node_modules/@appweaver/common/config/schema.json",
  "config": {
    "app": {
      "name": "Helpdesk API",
      "description": "Appweaver sample - Helpdesk API with support tickets, SLAs and integrations"
    },
    "server": {
      "host": "0.0.0.0",
      "port": 5004
    },
    "database": {
      "url": "mysql://${DB_USER:-helpdesk-api}:${DB_PASSWORD}@${DB_HOST:-localhost}:3306/${DB_NAME:-helpdesk-api}"
    },
    "redis": {
      "provider": "@appweaver/core/memory/in-memory"
    },
    "cache": {
      "provider": "@appweaver/core/cache/memory-cache"
    },
    "rateLimit": {
      "store": "in-memory"
    },
    "queue": {
      "provider": "@appweaver/core/queue/memory-queue"
    },
    "mailer": {
      "senderName": "Support",
      "senderAddress": "support@helpdesk.example.com"
    },
    "security": {
      "apiKey": {
        "enabled": true
      }
    },
    "system": {
      "adminInitialEmail": "admin@helpdesk.example.com"
    }
  },
  "environments": {
    "dev": {
      "log": {
        "level": "debug",
        "pretty": true
      },
      "mailer": {
        "provider": "@appweaver/core/mailer/json-mailer"
      }
    },
    "test": {
      "log": {
        "level": "silent",
        "sync": true
      },
      "database": {
        "url": "mysql://${DB_USER:-helpdesk-api}:${DB_PASSWORD}@${DB_HOST:-localhost}:3306/${DB_NAME:-helpdesk-api}-test",
        "schemaPath": "./temp/database/schema.prisma",
        "migrationsDirPath": "./temp/database/migrations",
        "clientOutputDirPath": "./temp/database/client"
      },
      "storage": {
        "path": "./temp/storage"
      },
      "redis": {
        "provider": "@appweaver/core/memory/in-memory"
      },
      "queue": {
        "provider": "@appweaver/core/queue/memory-queue"
      },
      "mailer": {
        "provider": "@appweaver/core/mailer/json-mailer"
      },
      "scheduler": {
        "autoStartJob": false
      }
    }
  }
}
