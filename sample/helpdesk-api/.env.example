NODE_ENV=dev

DB_PASSWORD=helpdesk-api

# The SMS 2FA codes are written to the log while developing, unless sent by
# Twilio from the SMS_SENDER number (never in the tests, see .env.test)
# SMS_SENDER=
# SMS_TWILIO_ACCOUNT_SID=
# SMS_TWILIO_AUTH_TOKEN=

# The phone number of the admin in the E.164 format, i.e. +385911234567, which
# the seeder verifies and enables the SMS 2FA of the admin with
# ADMIN_PHONE_NUMBER=

# Encrypts the TOTP secrets of the authenticator apps in the database, which
# the methods of the users can no longer be read with once it changes. Any
# secret text, i.e. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SECURITY_ACCOUNT_2FA_TOTP_ENCRYPTION_KEY=
