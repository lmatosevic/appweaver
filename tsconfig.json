{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2024",
    "outDir": "./dist",
    "strict": true,
    "sourceMap": true,
    "declaration": true,
    "stripInternal": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "incremental": true,
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "types": ["node", "jest", "bun"],
    "paths": {
      "@appweaver/common": ["./packages/common"],
      "@appweaver/common/*": ["./packages/common/*"],
      "@appweaver/core": ["./packages/core"],
      "@appweaver/core/*": ["./packages/core/*"],
      "@appweaver/ai": ["./packages/ai"],
      "@appweaver/ai/*": ["./packages/ai/*"],
      "@appweaver/openai": ["./packages/openai"],
      "@appweaver/openai/*": ["./packages/openai/*"],
      "@appweaver/sharp": ["./packages/sharp"],
      "@appweaver/sharp/*": ["./packages/sharp/*"],
      "@appweaver/skill": ["./packages/skill"],
      "@appweaver/skill/*": ["./packages/skill/*"],
      "@appweaver/tooling": ["./packages/tooling"],
      "@appweaver/tooling/*": ["./packages/tooling/*"],
      "@appweaver/cron": ["./packages/cron"],
      "@appweaver/cron/*": ["./packages/cron/*"],
      "@appweaver/nodemailer": ["./packages/nodemailer"],
      "@appweaver/nodemailer/*": ["./packages/nodemailer/*"],
      "@appweaver/mcp": ["./packages/mcp"],
      "@appweaver/mcp/*": ["./packages/mcp/*"],
      "@appweaver/realtime": ["./packages/realtime"],
      "@appweaver/realtime/*": ["./packages/realtime/*"],
      "@appweaver/twilio": ["./packages/twilio"],
      "@appweaver/twilio/*": ["./packages/twilio/*"],
      "@appweaver/handlebars": ["./packages/handlebars"],
      "@appweaver/handlebars/*": ["./packages/handlebars/*"],
      "@appweaver/opentelemetry": ["./packages/opentelemetry"],
      "@appweaver/opentelemetry/*": ["./packages/opentelemetry/*"],
      "@appweaver/redis": ["./packages/redis"],
      "@appweaver/redis/*": ["./packages/redis/*"],
      "@appweaver/bullmq": ["./packages/bullmq"],
      "@appweaver/bullmq/*": ["./packages/bullmq/*"],
      "@appweaver/testing": ["./packages/testing"],
      "@appweaver/testing/*": ["./packages/testing/*"],
      "@appweaver/data": ["./packages/data"],
      "@appweaver/data/*": ["./packages/data/*"],
      "@appweaver/web": ["./packages/web"],
      "@appweaver/web/*": ["./packages/web/*"],
      "@appweaver/cli": ["./packages/cli"],
      "@appweaver/cli/*": ["./packages/cli/*"],
      "@appweaver/client": ["./packages/client"],
      "@appweaver/client/*": ["./packages/client/*"],
      "@appweaver/create/*": ["./packages/create/*"]
    }
  },
  "include": ["packages/**/*", "eslint.config.mjs"],
  "exclude": ["node_modules", "dist", "packages/*/dist", "sample"]
}
