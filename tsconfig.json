{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2024",
    "baseUrl": "./",
    "outDir": "./dist",
    "strict": true,
    "sourceMap": true,
    "declaration": true,
    "stripInternal": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "incremental": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "paths": {
      "@appweaver/common": ["./packages/common"],
      "@appweaver/common/*": ["./packages/common/*"],
      "@appweaver/core": ["./packages/core"],
      "@appweaver/core/*": ["./packages/core/*"],
      "@appweaver/sharp": ["./packages/sharp"],
      "@appweaver/sharp/*": ["./packages/sharp/*"],
      "@appweaver/cron": ["./packages/cron"],
      "@appweaver/cron/*": ["./packages/cron/*"],
      "@appweaver/nodemailer": ["./packages/nodemailer"],
      "@appweaver/nodemailer/*": ["./packages/nodemailer/*"],
      "@appweaver/handlebars": ["./packages/handlebars"],
      "@appweaver/handlebars/*": ["./packages/handlebars/*"],
      "@appweaver/redis": ["./packages/redis"],
      "@appweaver/redis/*": ["./packages/redis/*"],
      "@appweaver/bullmq": ["./packages/bullmq"],
      "@appweaver/bullmq/*": ["./packages/bullmq/*"],
      "@appweaver/testing": ["./packages/testing"],
      "@appweaver/testing/*": ["./packages/testing/*"],
      "@appweaver/data": ["./packages/data"],
      "@appweaver/data/*": ["./packages/data/*"],
      "@appweaver/web": ["./packages/web"],
      "@appweaver/web/*": ["./packages/web/*"],
      "@appweaver/cli": ["./packages/cli"],
      "@appweaver/cli/*": ["./packages/cli/*"],
      "@appweaver/create/*": ["./packages/create/*"]
    }
  },
  "include": ["packages/**/*", "eslint.config.mjs"],
  "exclude": ["node_modules", "dist", "sample"]
}
