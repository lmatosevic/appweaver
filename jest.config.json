{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/jest.setup.js"],
  "moduleNameMapper": {
    "^@appweaver/(common|core|data|web|redis|bullmq|cron|nodemailer|handlebars|sharp|testing|cli|client|create)$": "<rootDir>/packages/$1/index",
    "^@appweaver/(common|core|data|web|redis|bullmq|cron|nodemailer|handlebars|sharp|testing|cli|client|create)/(.*)$": "<rootDir>/packages/$1/$2"
  },
  "testMatch": ["**/*.test.ts"],
  "testPathIgnorePatterns": ["/node_modules/", "/dist/"],
  "modulePathIgnorePatterns": ["<rootDir>/packages/[^/]+/dist/"],
  "transformIgnorePatterns": [],
  "transform": {
    "^.+\\.(t|j)s$": [
      "@swc/jest",
      {
        "jsc": {
          "parser": {
            "syntax": "typescript",
            "dynamicImport": true
          },
          "target": "ES2024"
        },
        "module": {
          "type": "commonjs"
        },
        "sourceMaps": "inline"
      }
    ]
  },
  "reporters": [
    "default",
    [
      "jest-junit",
      {
        "outputDirectory": "./reports",
        "outputName": "junit.xml"
      }
    ]
  ],
  "coverageReporters": ["cobertura", "text"],
  "collectCoverageFrom": [
    "packages/*/**/*.ts",
    "!**/test/**",
    "!**/*.d.ts",
    "!packages/data/prisma/client/**",
    "!packages/client/generated/**"
  ],
  "coverageDirectory": "./reports",
  "roots": ["<rootDir>/packages"],
  "coverageThreshold": {
    "global": {
      "branches": 80
    }
  }
}
