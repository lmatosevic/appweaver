{
  "$schema": "./node_modules/@appweaver/common/config/schema.json",
  "config": {
    "app": {
      "name": "Appweaver",
      "description": "Appweaver - the backend framework for AI-first development",
      "hostname": "http://localhost:5000",
      "runtime": "node",
      "buildPath": "./dist",
      "sourcePath": "./src",
      "scanFilesPattern": "<srcPath>/*/index.ts",
      "mainFilePath": "<srcPath>/main.ts",
      "autoloadModules": ["aws-storage", "service-bus"]
    },
    "server": {
      "port": 5000,
      "host": "0.0.0.0",
      "apiPrefix": "/api",
      "bodyMaxSize": "100M",
      "staticEnabled": true,
      "staticDirPath": "./public",
      "staticRoutePrefix": "/public",
      "staticResponseHeaders": [
        "Content-Security-Policy: script-src 'self'"
      ],
      "staticMaxAge": "30d",
      "staticAllowedHost": null,
      "trustProxy": true,
      "requestLoggingEnabled": false
    },
    "log": {
      "level": "info",
      "path": "./logs",
      "rotate": true,
      "rotateSize": "100M",
      "rotateMaxSize": "5G",
      "rotateMaxFiles": 1000,
      "rotateInterval": "1d",
      "rotateCompress": true,
      "pretty": false
    },
    "rateLimit": {
      "enabled": true,
      "max": 1000,
      "window": 60000,
      "allowList": ["127.0.0.1", "192.168.5.1"],
      "store": "redis"
    },
    "swagger": {
      "enabled": true,
      "path": "/swagger",
      "hideUntagged": false
    },
    "healthCheck": {
      "enabled": true,
      "auth": true,
      "routePrefix": "/health",
      "cacheTtl": 3000,
      "pickInstances": ["database", "redis", "storage"],
      "omitInstances": null
    },
    "cors": {
      "origin": "*",
      "methods": "*",
      "allowedHeaders": "*",
      "exposedHeaders": "*",
      "maxAge": 86400,
      "credentials": true
    },
    "resource": {
      "modelPattern": "<srcPath>/resources/*/*model.ts",
      "servicePattern": "<srcPath>/resources/*/*service.ts",
      "policyPattern": "<srcPath>/resources/*/*policy.ts",
      "routesPattern": "<srcPath>/resources/*/*route.ts",
      "generatedTypesPath": "<srcPath>/types/generated.ts"
    },
    "export": {
      "csv": {
        "delimiter": ";",
        "joinDelimiter": ",",
        "addHeaders": true,
        "addSepRow": false
      },
      "batchSize": 1000
    },
    "security": {
      "routePrefix": "/auth",
      "cacheTtl": 300000,
      "authOttTtl": 120000,
      "allowedRedirectHosts": "*",
      "store": {
        "provider": "@appweaver/core/security/store/redis-security-store",
        "keepDatabaseTable": false
      },
      "password": {
        "enabled": true,
        "minLength": 8,
        "maxLength": 100,
        "uppercase": true,
        "lowercase": true,
        "numeric": true,
        "special": true
      },
      "account": {
        "routePrefix": "/auth/account",
        "verifyEmail": {
          "enabled": true,
          "ottTtl": 7200000
        },
        "resetPassword": {
          "enabled": true,
          "ottTtl": 1800000
        },
        "2fa": {
          "enabled": true,
          "forced": false,
          "ottTtl": 300000
        }
      },
      "recaptcha": {
        "enabled": false,
        "secret": "8LcDc8AUBBBBNKcefrwaDdfDSFdsfaewf",
        "headerName": "x-recaptcha-token",
        "minScore": 0.4,
        "verifyUrl": "https://www.google.com/recaptcha/api/siteverify"
      },
      "basic": {
        "enabled": false,
        "realm": "example",
        "proxyMode": false
      },
      "apiKey": {
        "enabled": false,
        "keepDatabaseTable": false,
        "headerName": "x-api-key",
        "maxDuration": null,
        "delimiter": "AK"
      },
      "jwt": {
        "secret": "GdvCFezoPIZdOAN3IQZR3JhaAZH6S6AJ",
        "publicKeyPath": "./storage/keys/public.key",
        "privateKeyPath": "./storage/keys/private.key",
        "autoGenerateKeys": true,
        "expiresIn": 2592000,
        "refreshExpiresIn": 5184000
      },
      "oauth2": {
        "stateTtl": 600000,
        "registrationEnabled": true,
        "fetchAvatarEnabled": false,
        "connectedAccountsKeepDatabaseTable": false,
        "google": {
          "enabled": true,
          "clientId": "3255464567435-tzr346jsgh63462vdp234sodhpsfjzop.apps.googleusercontent.com",
          "clientSecret": "Hjksuzrnm32nb5kdsnu274nfS",
          "userInfoUrl": "https://www.googleapis.com/oauth2/v2/userinfo"
        },
        "facebook": {
          "enabled": true,
          "clientId": "152682898154865",
          "clientSecret": "89a8956f566c5655c6a56565a56c",
          "userInfoUrl": "https://graph.facebook.com/me"
        },
        "x": {
          "enabled": true,
          "clientId": "V1JhZXhhbXBsZWNsaWVudGlkOjE6Y2k",
          "clientSecret": "3dj4k2mfk39dkalq02mdk39dka02mdkq93",
          "userInfoUrl": "https://api.x.com/2/users/me"
        },
        "github": {
          "enabled": true,
          "clientId": "Iv1.8a61f9b3a7aba766",
          "clientSecret": "8a61f9b3a7aba7668a61f9b3a7aba7668a61f9b3",
          "userInfoUrl": "https://api.github.com/user"
        },
        "gitlab": {
          "enabled": true,
          "clientId": "7d1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d5e6f708192a3b4c5d6e7f8",
          "clientSecret": "gloas-1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d5e6f708192a3b4c5d6e7f8",
          "baseUrl": "https://gitlab.com",
          "userInfoUrl": "https://gitlab.com/api/v4/user"
        },
        "linkedin": {
          "enabled": true,
          "clientId": "86xk2mfk39dkal",
          "clientSecret": "WPL_AP1.3dj4k2mfk39dkalq.02mdkq",
          "userInfoUrl": "https://api.linkedin.com/v2/userinfo"
        },
        "apple": {
          "enabled": true,
          "clientId": "com.example.service",
          "teamId": "A1B2C3D4E5",
          "keyId": "F6G7H8I9J0",
          "privateKeyPath": "./storage/keys/apple-auth-key.p8",
          "clientSecretExpiresIn": 15552000
        },
        "microsoft": {
          "enabled": true,
          "clientId": "3f8e1c2a-9b4d-4e7f-8a1b-2c3d4e5f6071",
          "clientSecret": "Hj8Q~9dkalq02mdkq93dj4k2mfk39dkalq02mdkq",
          "tenant": "common",
          "userInfoUrl": "https://graph.microsoft.com/v1.0/me"
        },
        "custom": {
          "enabled": true,
          "clientId": "123345456723423",
          "clientSecret": "32432af767af8c7946d456a54ca5",
          "issuer": "https://keycloak.example.com/realms/my-realm"
        }
      }
    },
    "database": {
      "type": "postgresql",
      "url": "postgresql://appweaver:appweaver@localhost:5432/appweaver-sample?schema=public",
      "schemaPath": "./database/schema.prisma",
      "migrationsDirPath": "./database/migrations",
      "seedersDirPath": "./database/seeders",
      "clientOutputDirPath": "./database/client",
      "transactionMaxWait": 2000,
      "transactionTimeout": 5000,
      "logEvents": ["query", "info", "warn", "error"],
      "provider": "@appweaver/core/database/prisma-database"
    },
    "storage": {
      "path": "./storage",
      "reservedPaths": ["keys"],
      "namePattern": "{name}-{hash}.{extension}",
      "cacheTtl": 86400000,
      "filesRoutePrefix": "/files",
      "provider": "@appweaver/core/storage/filesystem-storage"
    },
    "redis": {
      "url": "redis://localhost:6379/0",
      "provider": "@appweaver/core/memory/redis"
    },
    "memory": {
      "maxSize": "100M",
      "provider": "@appweaver/core/memory/memory"
    },
    "cache": {
      "enabled": true,
      "cleanStart": false,
      "keyPrefix": "cache:",
      "maxItems": 1000,
      "maxSize": "100M",
      "defaultTtl": 5000,
      "evictionGracePeriod": 1000,
      "evictionStrategy": "LRU",
      "evictionDeferred": false,
      "invalidationStrategy": "expire-related",
      "invalidationDeferred": false,
      "provider": "@appweaver/core/cache/redis-cache"
    },
    "queue": {
      "keepCompletedCount": 0,
      "keepCompletedSeconds": null,
      "keepFailedCount": 50,
      "keepFailedSeconds": null,
      "retryAttempts": 3,
      "retryBackoff": 3000,
      "retryBackoffType": "fixed",
      "provider": "@appweaver/core/queue/bull-queue"
    },
    "scheduler": {
      "autoStartJob": true,
      "provider": "@appweaver/core/scheduler/cron-scheduler"
    },
    "events": {
      "maxListeners": 20,
      "provider": "@appweaver/core/events/node-events"
    },
    "mailer": {
      "senderName": "John Doe",
      "senderAddress": "no-reply@appweaver.co",
      "provider": "@appweaver/core/mailer/smtp-mailer",
      "smtp": {
        "host": "mail.appweaver.co",
        "port": 587,
        "secure": false,
        "user": "no-reply@appweaver.co",
        "password": ""
      }
    },
    "system": {
      "adminInitialEmail": "admin@appweaver.co",
      "adminInitialPassword": "Password1!"
    }
  }
}
